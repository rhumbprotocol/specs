# Rhumb Workflow Protocol: Dependencies Template v1.0
# Copy to {plan-dir}/dependencies.yaml and fill in
#
# Recommended for:
# - Any plan that is dependent on other plans
# - Plans that have non-linear phase dependencies
# - Plans with cross-plan phase dependencies
#
# Optional but recommended for all plans

plan_id: "{{PLAN_ID}}"  # e.g., MP-0001-disable-submit
request_id: "{{REQUEST_ID}}"
title: "{{PLAN_TITLE}}"
rwp_version: "{{RWP_VERSION}}"
created: "{{TIMESTAMP_ISO8601}}"
updated: "{{TIMESTAMP_ISO8601}}"

# ============================================================================
# BLOCKING DEPENDENCIES (Hard Block)
# ============================================================================
# Plans/phases that should complete BEFORE this plan can proceed.
#
# Types:
#   - plan_completion: Entire plan should complete
#   - phase_completion: Specific phase should complete

blocked_by:
  # Example 1: Block on entire plan
  # - id: MP-0064-example
  #   type: plan_completion
  #   required_phase: null
  #   reason: "Extension beta should complete before mobile bindings"

  # Example 2: Block on specific phase (cross-plan coordination)
  # - id: MP-0178-example
  #   type: phase_completion
  #   required_phase: P-02
  #   reason: "Need protocol specification from MP-0178-example P-02 for our P-04"
  #   affects_our_phases: [P-04, P-05]
  []

# ============================================================================
# PLANS THIS BLOCKS (Informational)
# ============================================================================
# Plans that depend on THIS plan completing.
# Used for dependency graph visualization.

blocks:
  # Example:
  # - MP-0068-example
  # - MP-0070-example
  []

# ============================================================================
# SOFT DEPENDENCIES (Context)
# ============================================================================
# Completed plans that informed this work.
# Not blocking, just for traceability.

depends_on:
  # Example:
  # - id: MP-0111-example
  #   status: completed
  #   reason: "Established validation patterns"
  []

# ============================================================================
# INTERNAL PHASE DEPENDENCIES
# ============================================================================
# Most plans have linear sub-phases (P-01-B depends on P-01-A).
# Only specify if sub-phases can run in parallel or have complex deps.

phase_deps:
  # --- Sub-Phase Pattern (Default) ---
  # Sequential within logical phase:
  P-01-A:
    depends_on: []
    title: "{{Phase 1 Sub-A Title}}"
  P-01-B:
    depends_on: [P-01-A]
    title: "{{Phase 1 Sub-B Title}}"
  P-01-C:
    depends_on: [P-01-B]
    title: "{{Phase 1 Sub-C Title}}"

  # Parallel logical phases (different tracks can run simultaneously):
  P-02-A:
    depends_on: [P-01-C]
    parallel_with: [P-03-A]
    title: "{{Phase 2 Sub-A Title}}"
  P-02-B:
    depends_on: [P-02-A]
    title: "{{Phase 2 Sub-B Title}}"

  P-03-A:
    depends_on: [P-01-C]
    parallel_with: [P-02-A]
    title: "{{Phase 3 Sub-A Title}}"
  P-03-B:
    depends_on: [P-03-A]
    title: "{{Phase 3 Sub-B Title}}"

  # Merge sub-phase (waits for parallel tracks):
  P-04-A:
    depends_on: [P-02-B, P-03-B]
    title: "{{Phase 4 Merge Sub-A Title}}"

  # Audit checkpoint sub-phase:
  P-04-C:
    depends_on: [P-04-B]
    audit_checkpoint: true
    title: "{{Phase 4 Audit Checkpoint}}"

# ============================================================================
# CROSS-PLAN COORDINATION
# ============================================================================
# Document bidirectional dependencies between plans.
# Used for parallel plan execution with staggered phase dependencies.

cross_plan_coordination:
  # Example: Bidirectional coordination with MP-0178-example
  # - plan: MP-0178-example
  #   our_phases_they_need: [P-01]     # They wait for our P-01
  #   their_phases_we_need: [P-02]     # We wait for their P-02
  #   status: coordinating             # coordinating | complete
  #
  # Visualization:
  #   MP-0177-example: P-01 ──────────────────→ P-04 (needs MP-0178-example P-02)
  #              ↓                        ↑
  #   MP-0178-example: P-01 → P-02 → P-03 ───────┘
  #                    ↑      ↓
  #                    └── (needs MP-0177-example P-01)
  []

# ============================================================================
# COMPUTED VALUES (Updated by your workflow system)
# ============================================================================
# Do not edit manually - your workflow system updates these.

computed:
  status: ready  # ready | blocked | completed
  unmet_blockers: []
  last_checked: "{{TIMESTAMP_ISO8601}}"

