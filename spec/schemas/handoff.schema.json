{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rhumbprotocol.dev/schemas/handoff.schema.json",
  "$comment": "See docs/PROTOCOL.md 'Artifact Types & Schemas' section for specification details",
  "type": "object",
  "title": "RWP Handoff Schema",
  "description": "JSON Schema for Rhumb Workflow Protocol (RWP) Handoff artifacts (HO-*.md). Validates the structure and required sections of phase completion documentation in Markdown format.",
  "required": ["metadata", "summary"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["filename", "phase", "date"],
      "additionalProperties": false,
      "description": "Handoff metadata",
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^HO-MP-[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*-P-[0-9]{2}(-[A-Z])?-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.md$",
          "description": "Standard handoff filename (e.g., HO-MP-0235-rhumb-workflow-protocol-P-01-C-2026-03-04.md)"
        },
        "phase": {
          "type": "string",
          "pattern": "^P-[0-9]{2}(-[A-Z])?$",
          "description": "Phase identifier"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Date of handoff (YYYY-MM-DD)"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 creation timestamp"
        },
        "created_by": {
          "type": "string",
          "description": "Tool or person who created handoff"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["phase", "status"],
      "additionalProperties": true,
      "description": "Executive summary of phase completion",
      "properties": {
        "phase": {
          "type": "string",
          "pattern": "^P-[0-9]{2}(-[A-Z])?$",
          "description": "Phase identifier"
        },
        "phase_title": {
          "type": "string",
          "description": "Full phase title"
        },
        "status": {
          "type": "string",
          "enum": ["completed", "partial", "blocked", "failed"],
          "description": "Completion status"
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 0,
          "description": "Actual duration in minutes"
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "Phase start timestamp"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Phase completion timestamp"
        }
      }
    },
    "deliverables": {
      "type": "object",
      "additionalProperties": true,
      "description": "Deliverables and their completion status",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "completed": { "type": "boolean" },
              "notes": { "type": "string" }
            }
          },
          "description": "List of deliverables with checkmarks"
        }
      }
    },
    "key_decisions": {
      "type": "array",
      "description": "Major decisions made during the phase",
      "items": {
        "type": "object",
        "properties": {
          "decision": { "type": "string" },
          "rationale": { "type": "string" },
          "alternatives_considered": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "session_metrics": {
      "type": "object",
      "description": "Quantified work metrics from the session",
      "additionalProperties": true,
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0,
          "description": "Total conversation turns"
        },
        "tool_calls": {
          "type": "object",
          "properties": {
            "reads": { "type": "integer" },
            "writes": { "type": "integer" },
            "tests": { "type": "integer" },
            "other": { "type": "integer" },
            "total": { "type": "integer" }
          },
          "description": "Breakdown of tool calls by type"
        },
        "lines_written": {
          "type": "integer",
          "minimum": 0,
          "description": "Total lines of code/content written"
        },
        "tests_passed": {
          "type": "integer",
          "minimum": 0
        },
        "tests_failed": {
          "type": "integer",
          "minimum": 0
        },
        "build_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "errors_encountered": {
          "type": "integer",
          "minimum": 0
        },
        "files_created": {
          "type": "integer",
          "minimum": 0
        },
        "files_modified": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rolling_context": {
      "type": "object",
      "description": "Context for the next phase",
      "additionalProperties": true,
      "properties": {
        "state": {
          "type": "string",
          "description": "Current state and setup status"
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Known blockers for next phase"
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Assumptions made during execution"
        },
        "recommendations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Recommendations for next phase"
        }
      }
    },
    "risks_and_mitigations": {
      "type": "array",
      "description": "Identified risks and their mitigations",
      "items": {
        "type": "object",
        "properties": {
          "risk": { "type": "string" },
          "probability": { "type": "string", "enum": ["low", "medium", "high"] },
          "impact": { "type": "string", "enum": ["low", "medium", "high"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "next_phase_blockers": {
      "type": "array",
      "description": "Explicit blockers preventing next phase (empty if none)",
      "items": { "type": "string" }
    }
  },
  "$examples": [
    {
      "metadata": {
        "filename": "HO-MP-0235-P-01-C-2026-03-04.md",
        "phase": "P-01-C",
        "date": "2026-03-04",
        "created_at": "2026-03-04T02:55:00Z",
        "created_by": "YAKKL Meridian"
      },
      "summary": {
        "phase": "P-01-C",
        "phase_title": "Format Specifications",
        "status": "COMPLETED",
        "duration_minutes": 45,
        "started_at": "2026-03-04T02:55:00Z",
        "completed_at": "2026-03-04T03:40:00Z"
      },
      "deliverables": {
        "items": [
          {
            "name": "plan.schema.json",
            "completed": true
          },
          {
            "name": "intake.schema.json",
            "completed": true
          },
          {
            "name": "manifest.schema.json",
            "completed": true
          },
          {
            "name": "state.schema.json",
            "completed": true
          }
        ]
      },
      "session_metrics": {
        "turns": 8,
        "tool_calls": {
          "reads": 3,
          "writes": 5,
          "tests": 1,
          "total": 9
        },
        "lines_written": 1240,
        "tests_passed": 24,
        "tests_failed": 0
      },
      "next_phase_blockers": []
    }
  ]
}
