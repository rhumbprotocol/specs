{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rhumbprotocol.dev/schemas/plan.schema.json",
  "$comment": "See docs/PROTOCOL.md 'Artifact Types & Schemas' section for specification details",
  "type": "object",
  "title": "RWP Plan Schema",
  "description": "JSON Schema for Rhumb Workflow Protocol (RWP) Plan artifacts (PLAN.md). Validates the structure of master workflow documents.",
  "required": ["plan_id", "title", "overview", "phases"],
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^MP-[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Canonical RWP plan identifier using MP-NNNN-short-name format"
    },
    "title": {
      "type": "string",
      "description": "Human-readable plan title",
      "minLength": 5,
      "maxLength": 200
    },
    "overview": {
      "type": "string",
      "description": "Executive summary of the plan's purpose, context, and scope",
      "minLength": 20
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when plan was created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "classification": {
      "type": "string",
      "enum": ["public", "private", "confidential"],
      "description": "Access classification level"
    },
    "owner": {
      "type": "string",
      "description": "Plan owner or team responsible"
    },
    "goals_and_success_criteria": {
      "type": "object",
      "description": "Goals and measurable success metrics",
      "properties": {
        "goals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "success_criteria": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "description": "All phases in execution order",
      "items": {
        "type": "object",
        "required": ["phase_id", "title", "objective", "deliverables", "tasks", "verification"],
        "additionalProperties": true,
        "properties": {
          "phase_id": {
            "type": "string",
            "pattern": "^P-[0-9]{2}(-[A-Z])?$",
            "description": "Phase identifier (e.g., P-01, P-01-A)"
          },
          "title": {
            "type": "string",
            "description": "Phase title and estimated duration"
          },
          "objective": {
            "type": "string",
            "description": "1-2 sentence statement of what will be accomplished"
          },
          "deliverables": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Concrete, measurable outputs"
          },
          "tasks": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Numbered steps to accomplish deliverables"
          },
          "verification": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Commands or tests proving completion"
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of phases that must complete first (e.g., [P-01, P-01-B])"
          },
          "duration_minutes": {
            "type": "integer",
            "minimum": 1,
            "description": "Estimated duration in minutes"
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": { "type": "string" },
                "mitigation": { "type": "string" }
              }
            },
            "description": "Known risks and mitigations"
          },
          "resources": {
            "type": "object",
            "description": "Team members, tools, infrastructure needed"
          }
        }
      }
    },
    "custom_fields": {
      "type": "object",
      "description": "Custom fields for domain-specific extensions",
      "additionalProperties": true
    }
  },
  "$examples": [
    {
      "title": "Build Analytics Platform",
      "overview": "3-phase development of a real-time analytics dashboard with WebSocket integration",
      "created_at": "2026-03-04T08:00:00Z",
      "classification": "confidential",
      "phases": [
        {
          "phase_id": "P-01",
          "title": "Data Pipeline Setup",
          "objective": "Build the data collection and normalization layer",
          "deliverables": ["schema.sql", "Python ETL job", "Database initialization script"],
          "tasks": ["Design schema", "Implement ETL", "Write tests"],
          "verification": ["pytest tests/ --cov=etl", "sqlfluff lint"],
          "duration_minutes": 480,
          "dependencies": []
        }
      ]
    }
  ]
}
