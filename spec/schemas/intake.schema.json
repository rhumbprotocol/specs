{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rhumbprotocol.dev/schemas/intake.schema.json",
  "$comment": "See docs/PROTOCOL.md 'Artifact Types & Schemas' section for specification details",
  "type": "object",
  "title": "RWP Intake Schema",
  "description": "JSON Schema for Rhumb Workflow Protocol (RWP) Intake artifacts (INTAKE.yaml). Validates formal request specifications capturing pain points, requirements, and constraints.",
  "required": ["id", "title", "captured", "pain_points", "requirements", "constraints", "success_criteria"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^INT-[0-9]{4}$",
      "description": "Unique intake identifier (e.g., INT-0001)"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "description": "Request title"
    },
    "summary": {
      "type": "string",
      "description": "Brief summary of the request and its context"
    },
    "captured": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when intake was captured"
    },
    "approved_by": {
      "type": "string",
      "description": "Person or team who approved this intake"
    },
    "approval_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of approval"
    },
    "classification": {
      "type": "string",
      "enum": ["public", "private", "confidential"],
      "description": "Access classification level"
    },
    "pain_points": {
      "type": "array",
      "minItems": 1,
      "description": "Problems being solved",
      "items": {
        "type": "object",
        "required": ["id", "description", "impact"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PP-[0-9]{2}$",
            "description": "Pain point identifier (e.g., PP-01)"
          },
          "description": {
            "type": "string",
            "description": "Description of the problem"
          },
          "impact": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"],
            "description": "Business impact severity"
          },
          "frequency": {
            "type": "string",
            "enum": ["constant", "daily", "weekly", "monthly", "rare"],
            "description": "How often the problem occurs"
          },
          "affected_teams": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Teams impacted by this pain point"
          },
          "business_impact": {
            "type": "string",
            "description": "Quantified business impact"
          },
          "examples": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Concrete examples of the problem"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "description": "Functional and non-functional requirements",
      "items": {
        "type": "object",
        "required": ["id", "type", "description", "acceptance"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{2}$",
            "description": "Requirement identifier (e.g., REQ-01)"
          },
          "type": {
            "type": "string",
            "enum": ["functional", "non-functional", "performance", "security", "compliance"],
            "description": "Type of requirement"
          },
          "description": {
            "type": "string",
            "description": "What is required"
          },
          "acceptance": {
            "type": "string",
            "description": "Acceptance criteria; how to verify completion"
          },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"],
            "description": "Priority level (P0 = critical)"
          },
          "verification": {
            "type": "string",
            "description": "How to verify this requirement is met"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "description": "Technical, business, legal, compliance constraints",
      "items": {
        "type": "object",
        "required": ["id", "type", "description"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CON-[0-9]{2}$",
            "description": "Constraint identifier (e.g., CON-01)"
          },
          "type": {
            "type": "string",
            "enum": ["technical", "business", "legal", "compliance", "resource"],
            "description": "Type of constraint"
          },
          "description": {
            "type": "string",
            "description": "Description of the constraint"
          },
          "rationale": {
            "type": "string",
            "description": "Why this constraint exists"
          },
          "negotiable": {
            "type": "boolean",
            "description": "Can this constraint be changed?"
          }
        }
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Measurable definition of completion"
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Assumptions about the project environment"
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Unresolved questions needing clarification"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "External dependencies (systems, teams, resources)"
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string" },
          "name": { "type": "string" },
          "responsibilities": { "type": "array", "items": { "type": "string" } }
        }
      },
      "description": "Key stakeholders and their roles"
    }
  },
  "$examples": [
    {
      "id": "INT-0001",
      "title": "Build Real-Time Analytics Platform",
      "captured": "2026-03-04T09:00:00Z",
      "approved_by": "product-leadership",
      "approval_date": "2026-03-04T14:00:00Z",
      "classification": "confidential",
      "pain_points": [
        {
          "id": "PP-01",
          "description": "Current analytics requires 24-hour batch refresh",
          "impact": "high",
          "frequency": "daily",
          "affected_teams": ["Product", "Operations"],
          "business_impact": "Customers cannot respond to incidents in real-time"
        }
      ],
      "requirements": [
        {
          "id": "REQ-01",
          "type": "functional",
          "description": "Real-time dashboard showing live metrics",
          "acceptance": "Metrics update within 5 seconds",
          "priority": "P0"
        }
      ],
      "constraints": [
        {
          "id": "CON-01",
          "type": "technical",
          "description": "Must use PostgreSQL",
          "negotiable": false
        }
      ],
      "success_criteria": [
        "All P0 requirements met",
        "5 pilot customers onboarded",
        "Performance benchmarks achieved"
      ]
    }
  ]
}
